{
  "name": "@quedevstudios/please-readme",
  "type": "module",
  "version": "0.0.0",
  "description": "An easy-to-use Readme generator that quickly creates well-structured and professional markdown files for your projects.",
  "author": {
    "name": "Blaque Allen",
    "email": "187586952+quedevstudios@users.noreply.github.com",
    "url": "https://quedevstudios.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/quedevstudios/please-readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/quedevstudios/please-readme.git"
  },
  "bugs": {
    "url": "https://github.com/quedevstudios/please-readme/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "readme",
    "generator",
    "cli",
    "markdown",
    "documentation",
    "project",
    "tool"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "please-readme": "./dist/cli.js"
  },
  "files": [
    "dist/**/*"
  ],
  "engines": {
    "bun": ">=1.2.5"
  },
  "scripts": {
    "dev": "bun run ./src-lib/index.ts",
    "build:lib": "rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "build:templates": "bun run ./scripts/build-templates.ts",
    "builder": "bun build:templates && bun build:lib",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "semantic-release",
    "prepare:git-hooks": "simple-git-hooks",
    "prepare": "bun prepare:git-hooks"
  },
  "peerDependencies": {
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "aether-bytes": "^1.3.0",
    "cosmiconfig": "^9.0.0",
    "handlebars": "^4.7.8",
    "node-fetch": "^3.3.2",
    "picocolors": "^1.1.1",
    "prettier": "^3.5.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.10.1",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@semantic-release/git": "^10.0.1",
    "@types/adm-zip": "^0.5.7",
    "@types/bun": "^1.2.5",
    "eslint": "^9.22.0",
    "lint-staged": "^15.5.0",
    "rollup": "^4.36.0",
    "rollup-plugin-dts": "^6.1.1",
    "semantic-release": "^24.2.3",
    "simple-git-hooks": "^2.11.1"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged",
    "commit-msg": "bunx commitlint --edit ${1}"
  },
  "lint-staged": {
    "*": "bunx eslint --fix"
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json"
          ],
          "message": "chore(release): v${nextRelease.version} [skip ci]"
        }
      ],
      [
        "@semantic-release/github",
        {
          "assets": []
        }
      ]
    ]
  }
}
